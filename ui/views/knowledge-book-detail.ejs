<%- include('partials/header', { title }); %>

<div class="mb-4">
  <div class="d-flex justify-content-between align-items-center">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/">Knowledge Collection</a></li>
          <li class="breadcrumb-item active" aria-current="page">Knowledge Book</li>
        </ol>
      </nav>
      <h1 class="mb-2"><%= knowledgeBook.title %></h1>
      <p class="lead text-muted">Search Query: "<%= knowledgeBook.query %>"</p>
    </div>
    <div>
      <a href="/" class="btn btn-outline-primary">
        <i class="bi bi-arrow-left me-2"></i>Back to Collection
      </a>
      <a href="/knowledge-book/<%= filename %>/export-html" class="btn btn-success ms-2">
        <i class="bi bi-download me-2"></i>Export HTML
      </a>
    </div>
  </div>
</div>

<!-- Knowledge Book Overview -->
<div class="card mb-4 shadow-sm">
  <div class="card-header bg-primary text-white">
    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Knowledge Book Overview</h5>
  </div>
  <div class="card-body">
    <div class="row">
      <div class="col-md-6">
        <dl class="row">
          <dt class="col-sm-4">Created:</dt>
          <dd class="col-sm-8"><%= new Date(knowledgeBook.created).toLocaleString() %></dd>
          <dt class="col-sm-4">Total Results:</dt>
          <dd class="col-sm-8"><%= knowledgeBook.totalResults %></dd>
          <dt class="col-sm-4">Sources Used:</dt>
          <dd class="col-sm-8"><%= knowledgeBook.sources.length %></dd>
          <dt class="col-sm-4">URLs Processed:</dt>
          <dd class="col-sm-8"><%= knowledgeBook.metadata?.urlsProcessed || 0 %></dd>
        </dl>
      </div>
      <div class="col-md-6">
        <dl class="row">
          <dt class="col-sm-4">Knowledge Book ID:</dt>
          <dd class="col-sm-8"><code><%= knowledgeBook.id %></code></dd>
          <dt class="col-sm-4">Filename:</dt>
          <dd class="col-sm-8"><code><%= filename.replace(/\.json$/, '') %></code></dd>
        </dl>
      </div>
    </div>
    
    <!-- Sources Used -->
    <% if (knowledgeBook.formattedStats && knowledgeBook.formattedStats.bySource && knowledgeBook.formattedStats.bySource.length > 0) { %>
      <div class="mt-3">
        <h6>Sources Used:</h6>
        <div class="mb-2">
          <% knowledgeBook.formattedStats.bySource.forEach(sourceInfo => { %>
            <span class="badge tag-badge <%= sourceInfo.class %> me-1"><%= sourceInfo.name %></span>
          <% }); %>
        </div>
      </div>
      
      <div class="mt-3">
        <h6>Results by Source:</h6>
        <div class="row">
          <% knowledgeBook.formattedStats.bySource.forEach(sourceInfo => { %>
            <div class="col-md-3 mb-2">
              <div class="text-center">
                <div class="h4 text-primary"><%= sourceInfo.count %></div>
                <span class="badge tag-badge <%= sourceInfo.class %>"><%= sourceInfo.name %></span>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    <% } else if (knowledgeBook.sources && knowledgeBook.sources.length > 0) { %>
      <div class="mt-3">
        <h6>Sources Used:</h6>
        <div class="mb-2">
          <% knowledgeBook.sources.forEach(source => { %>
            <% switch(source) { 
               case 'wikipedia': %>
                <span class="badge badge-wikipedia me-1">Wikipedia</span>
            <% break; 
               case 'openlibrary': %>
                <span class="badge badge-openlibrary me-1">OpenLibrary</span>
            <% break;
               case 'google': %>
                <span class="badge badge-google me-1">Google</span>
            <% break;
               case 'arxiv': %>
                <span class="badge badge-arxiv me-1">arXiv</span>
            <% break;
               default: %>
                <span class="badge bg-secondary me-1"><%= source %></span>
            <% } %>
          <% }); %>
        </div>
      </div>
    <% } %>
  </div>
</div>

<!-- Filter Status Display -->
<div id="filterStatus" class="alert alert-info mb-3" style="display: none;">
  <div class="d-flex justify-content-between align-items-center">
    <div>
      <i class="bi bi-funnel me-2"></i>
      <strong>Filtering by tag:</strong> <span id="currentFilterTag" class="badge bg-primary"></span>
      <span id="filteredCount" class="ms-2"></span>
    </div>
    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearTagFilter()">
      <i class="bi bi-x-circle me-1"></i>Clear Filter
    </button>
  </div>
</div>

<!-- Knowledge Book Items -->
<% if (knowledgeBook.enrichedItems && knowledgeBook.enrichedItems.length > 0) { %>
  <div class="card mb-4 shadow-sm">
    <div class="card-header bg-success text-white">
      <h5 class="mb-0">
        <i class="bi bi-collection me-2"></i>Knowledge Book Items
        <span class="badge bg-light text-dark ms-2"><%= knowledgeBook.enrichedItems.length %></span>
      </h5>
    </div>
    <div class="card-body">
      <% knowledgeBook.enrichedItems.forEach((item, index) => { %>
        <div class="search-result-item-list mb-3 knowledge-item" 
             data-tags="<%= item.tagClasses ? item.tagClasses.map(tag => tag.name).join(',') : '' %>"
             data-source="<%= item.source || '' %>">
          <div class="d-flex align-items-start">
            <div class="flex-grow-1">
              <h6>
                <strong><%= index + 1 %>.</strong>
                <a href="/knowledge-book/<%= encodeURIComponent(filename) %>/item/<%= index %>" class="text-decoration-none">
                  <%= item.title %>
                </a>
              </h6>
              <p class="text-muted mb-2"><%= item.description || item.summary || item.snippet || '' %></p>
              <div class="d-flex flex-wrap align-items-center gap-2">
                <% if (item.sourceClass) { %>
                  <small class="text-muted">
                    <i class="bi bi-globe"></i> 
                    <span class="badge tag-badge <%= item.sourceClass.class %>"><%= item.sourceClass.name %></span>
                  </small>
                <% } %>
                <% if (item.tagClasses && item.tagClasses.length > 0) { %>
                  <div class="tags-container">
                    <% item.tagClasses.forEach(tag => { %>
                      <span class="badge tag-badge <%= tag.class %> clickable-tag" 
                            onclick="filterByTag('<%= tag.name %>')" 
                            data-tag="<%= tag.name %>" 
                            style="cursor: pointer;" 
                            title="Click to filter by this tag">
                        <%= tag.name %>
                      </span>
                    <% }); %>
                  </div>
                <% } %>
                <% if (item.authors && item.authors.length > 0) { %>
                  <small class="text-muted">
                    <i class="bi bi-person me-1"></i>
                    <%= item.authors.slice(0, 2).join(', ') %><% if (item.authors.length > 2) { %> +<%= item.authors.length - 2 %> more<% } %>
                  </small>
                <% } %>
                <% if (item.published || item.publishedDate) { %>
                  <small class="text-muted">
                    <i class="bi bi-calendar3 me-1"></i>
                    <%= item.published || item.publishedDate %>
                  </small>
                <% } %>
              </div>
            </div>
          </div>
        </div>
        <% if (index < knowledgeBook.enrichedItems.length - 1) { %><hr><% } %>
      <% }); %>
    </div>
  </div>
<% } else if (knowledgeBook.results && knowledgeBook.results.length > 0) { %>
  <!-- Fallback display for direct results -->
  <div class="card mb-4 shadow-sm">
    <div class="card-header bg-success text-white">
      <h5 class="mb-0">
        <i class="bi bi-collection me-2"></i>Knowledge Book Items
        <span class="badge bg-light text-dark ms-2"><%= knowledgeBook.results.length %></span>
      </h5>
    </div>
    <div class="card-body">
      <% knowledgeBook.results.forEach((item, index) => { %>
        <div class="search-result-item-list mb-3 knowledge-item" 
             data-tags="<%= item.tags ? item.tags.join(',') : '' %>"
             data-source="<%= item.source || '' %>">
          <div class="d-flex align-items-start">
            <div class="flex-grow-1">
              <h6>
                <strong><%= index + 1 %>.</strong>
                <a href="/knowledge-book/<%= encodeURIComponent(filename) %>/item/<%= index %>" class="text-decoration-none">
                  <%= item.title %>
                </a>
              </h6>
              <p class="text-muted mb-2"><%= item.description || item.summary || item.snippet || '' %></p>
              <div class="d-flex flex-wrap align-items-center gap-2">
                <% if (item.source) { %>
                  <small class="text-muted">
                    <i class="bi bi-globe"></i> 
                    <span class="badge bg-primary"><%= item.source %></span>
                  </small>
                <% } %>
                <% if (item.tags && item.tags.length > 0) { %>
                  <div class="tags-container">
                    <% item.tags.forEach(tag => { %>
                      <span class="badge bg-secondary clickable-tag" 
                            onclick="filterByTag('<%= tag %>')" 
                            data-tag="<%= tag %>" 
                            style="cursor: pointer;" 
                            title="Click to filter by this tag">
                        <%= tag %>
                      </span>
                    <% }); %>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
        <% if (index < knowledgeBook.results.length - 1) { %><hr><% } %>
      <% }); %>
    </div>
  </div>
<% } else { %>
  <div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle me-2"></i>
    <h5>No Items Found</h5>
    <p class="mb-0">This Knowledge Book contains no items.</p>
  </div>
<% } %>

<!-- Actions -->
<div class="card mt-4 shadow-sm">
  <div class="card-body">
    <h6 class="card-title">Actions</h6>
    <div class="btn-group">
      <button class="btn btn-outline-info" onclick="exportKnowledgeBookHTML('<%= filename %>')">
        <i class="bi bi-download me-2"></i>Export HTML
      </button>
      <button class="btn btn-outline-warning" onclick="shareKnowledgeBook('<%= knowledgeBook.id %>')" disabled>
        <i class="bi bi-share me-2"></i>Share
      </button>
      <button class="btn btn-outline-danger" onclick="deleteKnowledgeBook('<%= filename %>', '<%= knowledgeBook.title %>')">
        <i class="bi bi-trash me-2"></i>Delete
      </button>
    </div>
  </div>
</div>

<script>
// Knowledge Book actions
function exportKnowledgeBookHTML(filename) {
  window.open(`/knowledge-book/${filename}/export-html`, '_blank');
}

function shareKnowledgeBook(bookId) {
  alert('Share functionality coming soon!');
}

function deleteKnowledgeBook(filename, title) {
  if (!confirm(`Are you sure you want to delete "${title}"?\n\nThis action cannot be undone.`)) {
    return;
  }

  fetch(`/knowledge-book/${encodeURIComponent(filename)}`, {
    method: 'DELETE',
    headers: {
      'Content-Type': 'application/json'
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      alert('Knowledge Book deleted successfully');
      window.location.href = '/?message=' + encodeURIComponent('Knowledge Book deleted successfully');
    } else {
      alert('Failed to delete Knowledge Book: ' + (data.message || 'Unknown error'));
    }
  })
  .catch(error => {
    console.error('Error deleting Knowledge Book:', error);
    alert('Failed to delete Knowledge Book due to network error');
  });
}

// Tag filtering functionality
let currentFilter = null;

function filterByTag(tagName) {
  currentFilter = tagName;
  const items = document.querySelectorAll('.knowledge-item');
  const filterStatus = document.getElementById('filterStatus');
  const currentFilterTag = document.getElementById('currentFilterTag');
  const filteredCount = document.getElementById('filteredCount');
  
  let visibleCount = 0;
  
  items.forEach(item => {
    const itemTags = item.getAttribute('data-tags');
    const tags = itemTags ? itemTags.split(',') : [];
    
    if (tags.includes(tagName)) {
      item.style.display = 'block';
      visibleCount++;
    } else {
      item.style.display = 'none';
    }
  });
  
  // Update filter status display
  currentFilterTag.textContent = tagName;
  filteredCount.textContent = `(${visibleCount} items shown)`;
  filterStatus.style.display = 'block';
  
  // Update all tag appearances to show active state
  updateTagActiveState(tagName);
}

function clearTagFilter() {
  currentFilter = null;
  const items = document.querySelectorAll('.knowledge-item');
  const filterStatus = document.getElementById('filterStatus');
  
  // Show all items
  items.forEach(item => {
    item.style.display = 'block';
  });
  
  // Hide filter status
  filterStatus.style.display = 'none';
  
  // Clear active state from all tags
  updateTagActiveState(null);
}

function updateTagActiveState(activeTag) {
  const allTags = document.querySelectorAll('.clickable-tag');
  
  allTags.forEach(tag => {
    const tagName = tag.getAttribute('data-tag');
    if (activeTag && tagName === activeTag) {
      tag.classList.add('active-filter');
      tag.style.opacity = '1';
      tag.style.transform = 'scale(1.05)';
    } else {
      tag.classList.remove('active-filter');
      tag.style.opacity = '';
      tag.style.transform = '';
    }
  });
}
</script>

<%- include('partials/footer'); %>
