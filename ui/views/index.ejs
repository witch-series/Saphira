<%- include('partials/header', { title }); %>

<% if (typeof message !== 'undefined' && message) { %>
  <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
    <i class="bi bi-check-circle-fill me-2"></i><%= message %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<!-- Header Section -->
<div class="mb-4">
  <div class="d-flex justify-content-between align-items-center">
    <div>
      <h1>Knowledge Collection</h1>
      <p class="lead text-muted">Your accumulated knowledge library from multi-source searches</p>
    </div>
    <div>
      <a href="/collection" class="btn btn-primary btn-lg">
        <i class="bi bi-plus-circle me-2"></i>New Search
      </a>
    </div>
  </div>
</div>

<div class="row">
  <!-- Main Content: Knowledge Books -->
  <div class="col-lg-8">
    <% if (typeof collection !== 'undefined' && collection.length > 0) { %>
      <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
          <h3 class="mb-0"><i class="bi bi-book-fill me-2"></i>Knowledge Books</h3>
        </div>
        <div class="card-body">
          <p class="card-text">Your saved Knowledge Books from multi-source searches. Click on a book to explore its contents.</p>
          
          <div class="list-group">
            <% collection.forEach(book => { %>
              <div class="list-group-item">
                <div class="d-flex w-100 justify-content-between align-items-start">
                  <div class="flex-grow-1">
                    <a href="/collection/knowledge-book/<%= encodeURIComponent(book.filename) %>" class="text-decoration-none">
                      <h5 class="mb-2 text-primary"><%= book.title %></h5>
                    </a>
                    
                    <p class="mb-2 text-muted">
                      <strong>Query:</strong> "<%= book.query %>" | 
                      <strong>Results:</strong> <%= book.totalResults %> | 
                      <strong>Created:</strong> <%= new Date(book.created).toLocaleDateString() %>
                    </p>
                    
                    <!-- Source Tags -->
                    <div class="mb-2">
                      <% if (book.sources && book.sources.length > 0) { %>
                        <% book.sources.forEach(source => { %>
                          <span class="badge badge-<%= source.toLowerCase() %> me-1"><%= source %></span>
                        <% }) %>
                      <% } %>
                    </div>
                    
                    <!-- Metadata -->
                    <small class="text-muted">
                      <%= book.filename.replace(/\.json$/, '') %>
                    </small>
                  </div>
                  
                  <div class="btn-group-vertical ms-3">
                    <a href="/collection/knowledge-book/<%= encodeURIComponent(book.filename) %>" class="btn btn-sm btn-outline-primary mb-1">
                      <i class="bi bi-eye"></i> View
                    </a>
                    <button class="btn btn-sm btn-outline-danger" onclick="deleteKnowledgeBook('<%= book.filename %>', '<%= book.title %>')">
                      <i class="bi bi-trash"></i> Delete
                    </button>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    <% } else { %>
      <!-- No Knowledge Books -->
      <div class="card mb-4 shadow-sm">
        <div class="card-body text-center py-5">
          <i class="bi bi-book display-1 text-muted mb-3"></i>
          <h3>No Knowledge Books Yet</h3>
          <p class="text-muted mb-4">Start your first multi-source search to create your first Knowledge Book.</p>
          <a href="/collection" class="btn btn-primary btn-lg">
            <i class="bi bi-search me-2"></i>Start Your First Search
          </a>
        </div>
      </div>
    <% } %>
  </div>

  <!-- Right sidebar: Statistics and Information -->
  <div class="col-lg-4">
    <!-- Collection Statistics -->
    <div class="card mb-4 shadow-sm">
      <div class="card-header bg-info text-white">
        <h5 class="mb-0"><i class="bi bi-graph-up me-2"></i>Collection Statistics</h5>
      </div>
      <div class="card-body">
        <% if (typeof stats !== 'undefined' && stats) { %>
          <div class="row text-center">
            <div class="col-6 border-end">
              <div class="h3 text-primary mb-0"><%= stats.totalBooks %></div>
              <small class="text-muted">Knowledge Books</small>
            </div>
            <div class="col-6">
              <div class="h3 text-success mb-0"><%= stats.totalResults %></div>
              <small class="text-muted">Total Results</small>
            </div>
          </div>
          
          <hr>
          
          <div class="row text-center">
            <div class="col-12">
              <div class="h4 text-warning mb-0">
                <% if (typeof urlStats !== 'undefined' && urlStats && urlStats.totalUrls) { %>
                  <%= urlStats.totalUrls %>
                <% } else { %>
                  0
                <% } %>
              </div>
              <small class="text-muted">URLs Processed</small>
            </div>
          </div>
          
          <% if (stats.sourceDistribution && Object.keys(stats.sourceDistribution).length > 0) { %>
            <hr>
            <h6>Source Usage:</h6>
            <% Object.entries(stats.sourceDistribution).forEach(([source, count]) => { %>
              <div class="d-flex justify-content-between">
                <span class="badge badge-<%= source.toLowerCase() %>"><%= source %></span>
                <span><%= count %> books</span>
              </div>
            <% }) %>
          <% } %>
        <% } else { %>
          <div class="text-center text-muted">
            <i class="bi bi-graph-up display-4 mb-3"></i>
            <p>No statistics available yet.</p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="card mb-4 shadow-sm">
      <div class="card-header bg-secondary text-white">
        <h5 class="mb-0"><i class="bi bi-tools me-2"></i>Quick Actions</h5>
      </div>
      <div class="card-body">
        <div class="d-grid gap-2">
          <a href="/collection" class="btn btn-primary">
            <i class="bi bi-search me-2"></i>New Search
          </a>
          <a href="/collection/knowledge-books" class="btn btn-outline-info">
            <i class="bi bi-collection me-2"></i>Browse Collection
          </a>
          <button class="btn btn-outline-secondary" onclick="showURLStats()">
            <i class="bi bi-link-45deg me-2"></i>URL Statistics
          </button>
          <button class="btn btn-outline-warning" onclick="exportKnowledgeCollection()">
            <i class="bi bi-download me-2"></i>Export Collection
          </button>
        </div>
      </div>
    </div>

    <!-- Information -->
    <div class="card shadow-sm">
      <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>About Knowledge Collection</h5>
      </div>
      <div class="card-body">
        <p>Knowledge Books are automatically created from your multi-source searches, combining results from:</p>
        <ul class="list-unstyled">
          <li><span class="badge badge-wikipedia">Wikipedia</span> Encyclopedia content</li>
          <li><span class="badge badge-openlibrary">OpenLibrary</span> Books and publications</li>
          <li><span class="badge badge-google">Google</span> Web search results</li>
          <li><span class="badge badge-arxiv">arXiv</span> Academic papers</li>
        </ul>
        <p class="mb-0">Each book preserves your search results with metadata and prevents duplicate URL processing.</p>
      </div>
    </div>
  </div>
</div>

<script>
// Knowledge Book deletion functionality
function deleteKnowledgeBook(filename, title) {
  if (!confirm(`Are you sure you want to delete "${title}"?\n\nThis action cannot be undone.`)) {
    return;
  }

  fetch(`/collection/knowledge-book/${encodeURIComponent(filename)}`, {
    method: 'DELETE',
    headers: {
      'Content-Type': 'application/json'
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      alert('Knowledge Book deleted successfully');
      window.location.reload();
    } else {
      alert('Failed to delete Knowledge Book: ' + (data.message || 'Unknown error'));
    }
  })
  .catch(error => {
    console.error('Error deleting Knowledge Book:', error);
    alert('Failed to delete Knowledge Book due to network error');
  });
}

// Show URL statistics (placeholder)
function showURLStats() {
  alert('Detailed URL statistics feature coming soon!');
}

// Export Knowledge Collection (placeholder)
function exportKnowledgeCollection() {
  alert('Export functionality coming soon!');
}
</script>

<%- include('partials/footer'); %>
