<%- include('partials/header', { title }); %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= collection.title %></h1>
  <div>
    <a href="/" class="btn btn-outline-secondary me-2">
      <i class="bi bi-house"></i> Home
    </a>
    <% if (isSearchCollection) { %>
      <a href="/search" class="btn btn-outline-primary me-2">
        <i class="bi bi-search"></i> New Search
      </a>
      <a href="/search/collection/delete/<%= collection.id %>" class="btn btn-outline-danger" 
         onclick="return confirm('Are you sure you want to delete this collection? This action cannot be undone.')">
        <i class="bi bi-trash"></i> Delete Collection
      </a>
    <% } else { %>
      <a href="/delete/<%= collection.id %>" class="btn btn-outline-danger" 
         onclick="return confirm('Are you sure you want to delete this knowledge book? This action cannot be undone.')">
        <i class="bi bi-trash"></i> Delete
      </a>
    <% } %>
  </div>
</div>

<!-- Collection Metadata -->
<div class="card mb-4 shadow-sm">
  <div class="card-body">
    <div class="row">
      <div class="col-md-6">
        <h5><%= isSearchCollection ? 'Search Query' : 'Source' %></h5>
        <p class="text-muted">
          <% if (isSearchCollection) { %>
            "<%= collection.query %>"
          <% } else { %>
            <%= collection.source || 'Unknown' %>
          <% } %>
        </p>
      </div>
      <div class="col-md-3">
        <h5>Date</h5>
        <p class="text-muted">
          <%= new Date(collection.date).toLocaleDateString() %> 
          <% if (isSearchCollection) { %>
            at <%= new Date(collection.date).toLocaleTimeString() %>
          <% } %>
        </p>
      </div>
      <div class="col-md-3">
        <h5>Items Count</h5>
        <p class="text-muted">
          <%= collection.totalResults %> 
          <%= isSearchCollection ? 'search results' : 'knowledge items' %>
        </p>
      </div>
    </div>
  </div>
</div>

<!-- Items List -->
<div class="card shadow-sm">
  <div class="card-body">
    <h3 class="card-title mb-4">
      <%= isSearchCollection ? 'Search Results' : 'Knowledge Items' %>
    </h3>
    
    <% if (items && items.length > 0) { %>
      <div class="row">
        <% items.forEach((item, index) => { %>
          <div class="col-md-6 mb-4">
            <div class="card h-100 border-left-primary">
              <div class="card-body">
                <h5 class="card-title">
                  <% if (item.sourceUrl) { %>
                    <a href="<%= item.sourceUrl %>" target="_blank" class="text-decoration-none">
                      <%= item.title %>
                      <i class="bi bi-box-arrow-up-right ms-1 small"></i>
                    </a>
                  <% } else { %>
                    <%= item.title %>
                  <% } %>
                </h5>
                
                <% if (item.summary) { %>
                  <p class="card-text text-muted"><%= item.summary %></p>
                <% } %>
                
                <% if (item.content && item.content.length > 0) { %>
                  <div class="mb-3">
                    <h6>Content Preview:</h6>
                    <p class="small text-muted">
                      <%= item.content.substring(0, 200) %>
                      <% if (item.content.length > 200) { %>...
                        <button class="btn btn-sm btn-link p-0" type="button" data-bs-toggle="collapse" 
                                data-bs-target="#content-<%= index %>" aria-expanded="false">
                          Show more
                        </button>
                      <% } %>
                    </p>
                    <% if (item.content.length > 200) { %>
                      <div class="collapse" id="content-<%= index %>">
                        <p class="small text-muted"><%= item.content.substring(200) %></p>
                      </div>
                    <% } %>
                  </div>
                <% } %>
                
                <div class="d-flex justify-content-between align-items-center">
                  <div>
                    <% if (item.tags && item.tags.length > 0) { %>
                      <% 
                        // Filter out common search tags for display
                        const displayTags = item.tags.filter(tag => 
                          tag !== 'search' && 
                          tag !== 'duckduckgo' && 
                          tag !== 'scraped'
                        ); 
                      %>
                      <% if (displayTags.length > 0) { %>
                        <% displayTags.slice(0, 3).forEach(tag => { %>
                          <span class="badge bg-light text-dark me-1"><%= tag %></span>
                        <% }) %>
                        <% if (displayTags.length > 3) { %>
                          <span class="badge bg-light text-dark">+<%= displayTags.length - 3 %></span>
                        <% } %>
                      <% } %>
                    <% } %>
                  </div>
                  <small class="text-muted">
                    <%= item.source || item.sourceName || 'Unknown' %> • 
                    <%= new Date(item.date || item.createdAt).toLocaleDateString() %>
                  </small>
                </div>
                
                <% if (!isSearchCollection) { %>
                  <!-- Action buttons for individual knowledge books -->
                  <div class="mt-3">
                    <a href="/details/<%= item.id %>" class="btn btn-sm btn-outline-primary">
                      <i class="bi bi-eye"></i> View Details
                    </a>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No items found in this collection.
      </div>
    <% } %>
  </div>
</div>

<style>
.border-left-primary {
  border-left: 4px solid #007bff !important;
}
</style>

<%- include('partials/footer'); %>
